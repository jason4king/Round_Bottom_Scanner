# Replace the server_name and frontend root with the VPS values.
# Build the frontend with: cd frontend && npm ci && npm run build
server {
    listen 80;
    server_name YOUR_VPS_VPN_NAME_OR_IP;

    root /opt/round-bottom-scanner/frontend/dist;
    index index.html;

    # Keep the browser on one origin. The frontend calls relative /api/... URLs.
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
