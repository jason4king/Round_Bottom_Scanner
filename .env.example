# Recommended authentication mode. OAuth tokens are managed by the SDK.
LONGPORT_AUTH_MODE=oauth
LONGPORT_OAUTH_CLIENT_ID=your-oauth-client-id
LONGPORT_REGION=hk
NETWORK_PROXY_ENABLED=false
NETWORK_PROXY_HOST=127.0.0.1
NETWORK_PROXY_PORT=7890

# Legacy API Key fallback only. Never commit real credentials.
LONGPORT_APP_KEY=your-app-key
LONGPORT_APP_SECRET=your-app-secret
LONGPORT_ACCESS_TOKEN=your-access-token

SCANNER_HOST=127.0.0.1
SCANNER_PORT=8000
TAIL_REFRESH_BARS=3
AUTO_BACKFILL_NEW_SYMBOLS=true
DEDUPLICATE_UNCHANGED_RESULTS=true

# Default: retain all historical bars.
# CACHE_RETENTION_BARS=1500
