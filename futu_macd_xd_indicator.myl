{ MACD XD - Futu NiuNiu / Moomoo formula edition }
{ Create as a sub-chart indicator. No external parameters are required. }

FAST:=12;
SLOW:=26;
SIGNAL:=9;

{ Current-timeframe MACD. HIST is deliberately not multiplied by 2 here. }
DIF0:=EMA(C,FAST)-EMA(C,SLOW);
DEA0:=EMA(DIF0,SIGNAL);
HIST:=DIF0-DEA0;

{ Slim solid bars; colour depth indicates strengthening or weakening. }
STICKLINE(HIST>=0 AND HIST>REF(HIST,1),0,HIST*2,1,0),COLOR26A69A;
STICKLINE(HIST>=0 AND HIST<=REF(HIST,1),0,HIST*2,1,0),COLORB2DFDB;
STICKLINE(HIST<0 AND HIST>REF(HIST,1),0,HIST*2,1,0),COLORFFCDD2;
STICKLINE(HIST<0 AND HIST<=REF(HIST,1),0,HIST*2,1,0),COLORFF5252;

DIF:DIF0,COLORBLUE;
DEA:DEA0,COLORRED;

{ Histogram-segment area and XD divergence. }
{ A segment ends only when HIST changes sign, matching the source indicator. }
TONEG:=HIST<0 AND REF(HIST,1)>=0;
TOPOS:=HIST>0 AND REF(HIST,1)<=0;
TURN:=TONEG OR TOPOS;
SEGLEN:=BARSLAST(TURN)+1;
AREA0:=SUM(HIST,SEGLEN);

MACD0:=HIST*2;

{ At a zero-axis turn, the segment ending on the preceding bar is complete. }
{ Snapshot its length, area, histogram extreme, price extreme and endpoint. }
NEGLEN:=REF(SEGLEN,1);
NEGAREA:=REF(AREA0,1);
NEGHIST:=LLV(REF(MACD0,1),NEGLEN);
NEGPRICE:=LLV(REF(L,1),NEGLEN);
NEGBACK:=LLVBARS(REF(MACD0,1),NEGLEN)+1;

POSLEN:=REF(SEGLEN,1);
POSAREA:=REF(AREA0,1);
POSHIST:=HHV(REF(MACD0,1),POSLEN);
POSPRICE:=HHV(REF(H,1),POSLEN);
POSBACK:=HHVBARS(REF(MACD0,1),POSLEN)+1;

{ Distance from this completed segment to the preceding segment of same sign. }
NEGGAP:=BARSLAST(REF(TOPOS,1))+1;
POSGAP:=BARSLAST(REF(TONEG,1))+1;
HASPREVNEG:=REF(TOPOS,NEGGAP);
HASPREVPOS:=REF(TONEG,POSGAP);

{ True XD divergence requires price, area and histogram to diverge together. }
{ Bullish: price makes a lower low while negative area and trough contract. }
BOTCONF:=TOPOS AND HASPREVNEG AND REF(DIF0,1)<0 AND NEGPRICE<REF(NEGPRICE,NEGGAP) AND NEGAREA>REF(NEGAREA,NEGGAP) AND NEGHIST>REF(NEGHIST,NEGGAP);

{ Bearish: price makes a higher high while positive area and peak contract. }
TOPCONF:=TONEG AND HASPREVPOS AND REF(DIF0,1)>0 AND POSPRICE>REF(POSPRICE,POSGAP) AND POSAREA<REF(POSAREA,POSGAP) AND POSHIST<REF(POSHIST,POSGAP);

{ Back-fill confirmation to the exact histogram extremes of both segments. }
BOTENDSET:=BACKSET(BOTCONF,NEGBACK+1);
BOTSTARTSET:=BACKSET(BOTCONF,NEGGAP+REF(NEGBACK,NEGGAP)+1);
BOTEND:=CROSS(BOTENDSET,0.5);
BOTSTART:=CROSS(BOTSTARTSET,0.5);

TOPENDSET:=BACKSET(TOPCONF,POSBACK+1);
TOPSTARTSET:=BACKSET(TOPCONF,POSGAP+REF(POSBACK,POSGAP)+1);
TOPEND:=CROSS(TOPENDSET,0.5);
TOPSTART:=CROSS(TOPSTARTSET,0.5);

DRAWLINE(TOPSTART,MACD0,TOPEND,MACD0,0,COLORMAGENTA);
DRAWLINE(BOTSTART,MACD0,BOTEND,MACD0,0,COLORGREEN);

{ Conventional price/DIF divergence for highs or lows that do not align }
{ with two same-sign histogram segments. N bars on the right confirm a pivot. }
{ Price determines the pattern; the line endpoints use the actual nearby DIF extremes. }
N:=3;
PHTEST:=REF(H,N)=HHV(H,2*N+1);
PLTEST:=REF(L,N)=LLV(L,2*N+1);

TOPPRICE0:=REF(H,N);
BOTPRICE0:=REF(L,N);
TOPDIF0:=HHV(DIF0,2*N+1);
BOTDIF0:=LLV(DIF0,2*N+1);
TOPDIFBACK:=HHVBARS(DIF0,2*N+1);
BOTDIFBACK:=LLVBARS(DIF0,2*N+1);

TOPCAND:=FILTER(PHTEST,N) AND TOPDIF0>0;
BOTCAND:=FILTER(PLTEST,N) AND BOTDIF0<0;
PHGAP:=BARSLAST(REF(TOPCAND,1))+1;
PLGAP:=BARSLAST(REF(BOTCAND,1))+1;
HASPREVPH:=REF(TOPCAND,PHGAP);
HASPREVPL:=REF(BOTCAND,PLGAP);
REGTOPCONF:=TOPCAND AND HASPREVPH AND TOPPRICE0>REF(TOPPRICE0,PHGAP) AND TOPDIF0<REF(TOPDIF0,PHGAP);
REGBOTCONF:=BOTCAND AND HASPREVPL AND BOTPRICE0<REF(BOTPRICE0,PLGAP) AND BOTDIF0>REF(BOTDIF0,PLGAP);

REGTOPENDSET:=BACKSET(REGTOPCONF,TOPDIFBACK+1);
REGTOPSTARTSET:=BACKSET(REGTOPCONF,PHGAP+REF(TOPDIFBACK,PHGAP)+1);
REGTOPEND:=CROSS(REGTOPENDSET,0.5);
REGTOPSTART:=CROSS(REGTOPSTARTSET,0.5);

REGBOTENDSET:=BACKSET(REGBOTCONF,BOTDIFBACK+1);
REGBOTSTARTSET:=BACKSET(REGBOTCONF,PLGAP+REF(BOTDIFBACK,PLGAP)+1);
REGBOTEND:=CROSS(REGBOTENDSET,0.5);
REGBOTSTART:=CROSS(REGBOTSTARTSET,0.5);

DRAWLINE(REGTOPSTART,DIF0,REGTOPEND,DIF0,0,COLORMAGENTA);
DRAWLINE(REGBOTSTART,DIF0,REGBOTEND,DIF0,0,COLORGREEN);

DRAWTEXT(TOPEND,MACD0,'空'),COLORMAGENTA;
DRAWTEXT(BOTEND,MACD0,'多'),COLORGREEN;
DRAWTEXT(REGTOPEND,DIF0,'空'),COLORMAGENTA;
DRAWTEXT(REGBOTEND,DIF0,'多'),COLORGREEN;

{ Numeric outputs available to Futu quant/backtest conditions. }
XD_TOP:TOPEND OR REGTOPEND,NODRAW;
XD_BOTTOM:BOTEND OR REGBOTEND,NODRAW;
XD_AREA:AREA0,NODRAW;
